;; Tasks for malai. Run them as `jolt <task>` (jolt reads bb.edn); `bb <task>`
;; works too. `jolt info` lists them.
{:paths ["src/clj"]
 :tasks
 {:requires ([clojure.edn :as edn] [clojure.string :as str])
  :init (do
          ;; $JOLT wins, then jolt on PATH
          (defn jolt-bin [] (or (System/getenv "JOLT") "jolt"))
          (def under-bb? (some? (System/getProperty "babashka.version"))))

  info {:doc "List the tasks with what each one does"
        :task (let [tasks (:tasks (edn/read-string (slurp "bb.edn")))]
                (println "malai tasks (run as: jolt <task>)")
                (doseq [[k v] (sort-by (fn [[k _]] (str k)) tasks)
                        :when (and (symbol? k) (map? v))]
                  (println (format "  %-14s %s" k (:doc v "")))))}

  test {:doc "Run the suite on Jolt: upstream Specter's tests and malai's own (test/malai/jolt_runner.jolt)"
        :task (shell (jolt-bin) "-M:test-jolt")}

  test:clj {:doc "Run the suite on the JVM with leiningen (upstream's task)"
            :task (shell "lein test")}

  test:cljs {:doc "Run cljs tests with leiningen (upstream's task)"
             :task (shell "lein doo node test-build once")}

  test:bb {:doc "Run the suite on babashka (upstream's task); under jolt it hands off to bb"
           :extra-paths ["test"]
           :extra-deps {org.clojure/test.check {:mvn/version "0.9.0"}
                        io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.0" :git/sha "b3fd0d2"}
                        org.clojure/tools.namespace {:git/url "https://github.com/babashka/tools.namespace"
                                                     :git/sha "3625153ee66dfcec2ba600851b5b2cbdab8fae6c"}}
           :task (if under-bb?
                   (apply (requiring-resolve 'cognitect.test-runner/-main)
                          "-d" "test"
                          *command-line-args*)
                   (apply shell "bb test:bb" *command-line-args*))}

  verify {:doc "The gate: test (Jolt), test:clj (JVM), test:bb (babashka); stops at the first failure"
          :task (doseq [t ["test" "test:clj" "test:bb"]]
                  (println (str "== " t))
                  (shell (if under-bb? "bb" (jolt-bin)) t))}

  bench {:doc "Timings of Specter paths on Jolt, cached and not, warm and cold (bench/malai/bench.clj; report only)"
         :task (shell (jolt-bin) "-M:bench")}

  smoke:build {:doc "Build smoke/malai/smoke.clj with jolt build, default and --closed-world, run both and check their output (about 15 s per build)"
               :task (let [expected (str ":nested-view [[1] [3]]\n"
                                         ":collected [[3 4]]\n"
                                         ":loop [[1 3] [2 4] [nil nil]]\n"
                                         ":malai-core [3]\n"
                                         ":compiled-dynamic-sites 5\n")]
                       (shell "mkdir -p target")
                       (doseq [[out flags] [["target/smoke-default" []]
                                            ["target/smoke-cw" ["--closed-world"]]]]
                         (println (str "== " out))
                         (apply shell (jolt-bin) "-A:smoke" "build" "-m" "malai.smoke" "-o" out flags)
                         (let [got (:out (shell {:out :string} out))]
                           (when-not (= expected got)
                             (println (str "smoke:build: " out " printed:\n" got "expected:\n" expected))
                             (System/exit 1))
                           (println "ok"))))}

  ;; Report only: findings never fail these. metrics.cli exits non-zero
  ;; only on bad usage or a missing directory, and that exit passes through.
  metrics {:doc "jolt-metrics report over the repo (Markdown; findings never fail it). Extra args go to metrics.cli: an output file (its extension picks the format), --top N, --no-git, --exclude GLOB"
           :task (apply shell (jolt-bin) "-M:metrics" "." *command-line-args*)}
  metrics:edn {:doc "jolt-metrics findings as EDN (findings never fail it). Extra args as for metrics"
               :task (apply shell (jolt-bin) "-M:metrics" "." "--format" "edn" *command-line-args*)}
  metrics:html {:doc "jolt-metrics as one self-contained HTML page, target/metrics.html unless a file comes first (findings never fail it). Extra args as for metrics"
                :task (let [args *command-line-args*
                            out? (and (seq args) (not (str/starts-with? (first args) "-")))
                            args (if out? args (cons "target/metrics.html" args))
                            dir (re-find (re-pattern "^.*/") (first args))]
                        (when dir (shell "mkdir -p" dir))
                        (apply shell (jolt-bin) "-M:metrics" "." "--format" "html" args))}}}
