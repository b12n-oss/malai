;; Tasks for Malai. Run them as `jolt <task>`: Jolt reads bb.edn. Malai's
;; tooling runs on Jolt alone; babashka is not needed. `jolt info` lists them.
{:paths ["src/clj"]
 :tasks
 {:requires ([clojure.edn :as edn] [clojure.string :as str] [babashka.fs :as fs] [babashka.process :as process])
  :init (do
          ;; $JOLT wins, then jolt on PATH
          (defn jolt-bin [] (or (System/getenv "JOLT") "jolt"))
          ;; The docs site is rendered by jlt-commons/docs-engine, which lives in
          ;; its own repo; site:* tasks delegate to it and only preview locally.
          ;; Found via $JLT_DOCS_ENGINE (or $DOCS_ENGINE), then
          ;; ~/dev/jlt-commons/docs-engine, then a sibling checkout.
          (def docs-engine-repo "https://github.com/jlt-commons/docs-engine")
          (defn docs-engine-dir []
            (let [home (System/getProperty "user.home")]
              (->> [(System/getenv "JLT_DOCS_ENGINE")
                    (System/getenv "DOCS_ENGINE")
                    (str home "/dev/jlt-commons/docs-engine")
                    "../docs-engine"]
                   (remove nil?)
                   (filter (fn [d] (fs/exists? (fs/file d "bb.edn"))))
                   first)))
          ;; The engine's build and clean run under jolt as `jolt run <task>`
          ;; (bare `jolt build` is jolt's own native build). Proxy vars cleared:
          ;; the engine fetches markdown-clj and selmer on first run.
          (defn site-task [task & args]
            (if-let [engine (docs-engine-dir)]
              (let [argv (into [(jolt-bin) "run" task] (cons (str (fs/canonicalize ".")) (remove nil? args)))
                    res (apply process/shell {:dir (str engine) :continue true
                                              :extra-env {"HTTPS_PROXY" "" "https_proxy" ""
                                                          "HTTP_PROXY" "" "http_proxy" ""}}
                               argv)]
                (when-not (zero? (:exit res)) (System/exit (:exit res))))
              (do
                (println "The docs engine is not checked out anywhere I looked:")
                (println "  $JLT_DOCS_ENGINE, $DOCS_ENGINE, ~/dev/jlt-commons/docs-engine, ../docs-engine")
                (println)
                (println (str "  git clone " docs-engine-repo " ~/dev/jlt-commons/docs-engine"))
                (System/exit 1))))
          ;; Binding the wildcard address without SO_REUSEADDR is the test, so a
          ;; port held on any interface counts as busy.
          (defn can-bind? [p]
            (let [s (java.net.ServerSocket.)]
              (.setReuseAddress s false)
              (try (.bind s (java.net.InetSocketAddress. (int p)))
                   true
                   (catch Exception _ false)
                   (finally (.close s)))))
          (defn free-port [base span]
            (first (filter can-bind? (range base (inc (+ base span))))))
          ;; The site's URLs all start with /malai/, so the static server's root
          ;; holds one link, malai -> _site, and the pages load as they will
          ;; when published.
          (defn serve-site [port]
            (site-task "build")
            (let [root "target/site-root"]
              (fs/delete-tree root)
              (fs/create-dirs root)
              (fs/create-sym-link (fs/path root "malai") (fs/canonicalize "_site"))
              (println (str "Serving the docs site at http://localhost:" port "/malai/ (Ctrl-C stops it)"))
              (shell "python3" "-m" "http.server" (str port) "--bind" "127.0.0.1" "--directory" root))))

  info {:doc "List the tasks with what each one does"
        :task (let [tasks (:tasks (edn/read-string (slurp "bb.edn")))]
                (println "Malai tasks (run as: jolt <task>)")
                (doseq [[k v] (sort-by (fn [[k _]] (str k)) tasks)
                        :when (and (symbol? k) (map? v))]
                  (println (format "  %-14s %s" k (:doc v "")))))}

  test {:doc "Run the suite on Jolt: upstream Specter's tests and malai's own (test/malai/jolt_runner.jolt)"
        :task (shell (jolt-bin) "-M:test-jolt")}

  test:clj {:doc "Run the suite on the JVM with leiningen (upstream's task)"
            :task (shell "lein test")}

  test:cljs {:doc "Run cljs tests with leiningen (upstream's task)"
             :task (shell "lein doo node test-build once")}

  verify {:doc "The gate: test (Jolt), then test:clj (JVM); stops at the first failure"
          :task (doseq [t ["test" "test:clj"]]
                  (println (str "== " t))
                  (shell (jolt-bin) t))}

  bench {:doc "Timings of Specter paths on Jolt, cached and not, warm and cold (bench/malai/bench.clj; report only)"
         :task (shell (jolt-bin) "-M:bench")}

  smoke:build {:doc "Build smoke/malai/smoke.clj with jolt build, default and --closed-world, run both and check their output (about 15 s per build)"
               :task (let [expected (str ":nested-view [[1] [3]]\n"
                                         ":collected [[3 4]]\n"
                                         ":loop [[1 3] [2 4] [nil nil]]\n"
                                         ":malai-core [3]\n"
                                         ":compiled-dynamic-sites 5\n")]
                       (shell "mkdir -p target")
                       (doseq [[out flags] [["target/smoke-default" []]
                                            ["target/smoke-cw" ["--closed-world"]]]]
                         (println (str "== " out))
                         (apply shell (jolt-bin) "-A:smoke" "build" "-m" "malai.smoke" "-o" out flags)
                         (let [got (:out (shell {:out :string} out))]
                           (when-not (= expected got)
                             (println (str "smoke:build: " out " printed:\n" got "expected:\n" expected))
                             (System/exit 1))
                           (println "ok"))))}

  site:build {:doc "Build the documentation site (docs/guide, docs/site.edn) into _site/ with jlt-commons/docs-engine"
              :task (site-task "build")}
  ;; No port given: scan from 3000 for a free one. A port you name is used
  ;; strictly and refused when busy, never swapped for another.
  site:serve {:doc "Build the docs site and serve _site/ locally at /malai/ with a static file server (python3); first free port from 3000, or site:serve PORT (refused if busy)"
              :task (let [requested (first *command-line-args*)
                          port (when requested (parse-long requested))]
                      (when (and requested (not (and port (<= 1 port 65535))))
                        (println (str "site:serve: the port is a number from 1 to 65535, not " requested))
                        (System/exit 1))
                      (if port
                        (if (can-bind? port)
                          (serve-site port)
                          (do (println (str "site:serve: port " port " is busy; pick another, or drop the argument to scan from 3000"))
                              (System/exit 1)))
                        (if-let [p (free-port 3000 100)]
                          (do (println (str "site:serve: using free port " p))
                              (serve-site p))
                          (do (println "site:serve: no free port in 3000..3100")
                              (System/exit 1)))))}
  site:clean {:doc "Delete the _site/ build output"
              :task (site-task "clean")}

  ;; Report only: findings never fail these. metrics.cli exits non-zero
  ;; only on bad usage or a missing directory, and that exit passes through.
  metrics {:doc "jolt-metrics report over the repo (Markdown; findings never fail it). Extra args go to metrics.cli: an output file (its extension picks the format), --top N, --no-git, --exclude GLOB"
           :task (apply shell (jolt-bin) "-M:metrics" "." *command-line-args*)}
  metrics:edn {:doc "jolt-metrics findings as EDN (findings never fail it). Extra args as for metrics"
               :task (apply shell (jolt-bin) "-M:metrics" "." "--format" "edn" *command-line-args*)}
  metrics:html {:doc "jolt-metrics as one self-contained HTML page, target/metrics.html unless a file comes first (findings never fail it). Extra args as for metrics"
                :task (let [args *command-line-args*
                            out? (and (seq args) (not (str/starts-with? (first args) "-")))
                            args (if out? args (cons "target/metrics.html" args))
                            dir (re-find (re-pattern "^.*/") (first args))]
                        (when dir (shell "mkdir -p" dir))
                        (apply shell (jolt-bin) "-M:metrics" "." "--format" "html" args))}}}
